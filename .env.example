# Copy to .env for Docker Compose, or backend/.env for a local run. Every backend setting has the RCS_ prefix.

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a development key is written to backend/data/master.key.
RCS_MASTER_KEY=

POSTGRES_PASSWORD=change-me

# Password for the seeded accounts. Required when RCS_ENV=production, where the published demo password is refused.
# RCS_SEED_PASSWORD=

# Local run defaults to SQLite. PostgreSQL example:
# RCS_DATABASE_URL=postgresql+psycopg://rcs:change-me@localhost:5432/rcs

# Optional MQTT broker. Empty keeps events on the in-process bus.
# RCS_MQTT_URL=mqtt://localhost:1883

# Frontend hosted separately, such as on Vercel. Both are read at build time, so redeploy after changing them.
# API_ORIGIN=https://your-backend.example.com
# NEXT_PUBLIC_WS_URL=wss://your-backend.example.com/api/ws/live
# NEXT_PUBLIC_HIDE_DEMO_LOGINS=1

# Set to true when the site is served over HTTPS.
RCS_COOKIE_SECURE=false
RCS_SESSION_HOURS=12
RCS_AUTOSTART_LIVE=true
RCS_LIVE_PREWARM_HOURS=3
RCS_WORKER_PROCESSES=2
RCS_SEED_DEMO=true
